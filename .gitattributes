* text=auto

# Shell-скрипты исполняются в Linux-контейнерах и на серверах: CRLF в шебанге
# ломает exec (например, postgres init-runtime-roles.sh на Windows-чекауте).
*.sh text eol=lf
chatballs text eol=lf

# Dockerfile и манифесты стека читают Linux-инструменты: CR в них ломает
# RUN-строки и heredoc'и ровно так же, как шебанг.
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
compose*.yaml text eol=lf
Caddyfile text eol=lf
*.sql text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
