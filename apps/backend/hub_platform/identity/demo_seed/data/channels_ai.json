  "knowledge": [
    {
      "key": "vektor-overview",
      "title": "Вектор — обзор продукта",
      "description": "Краткое описание SCADA-системы Вектор для предпродажных консультаций.",
      "content": "Вектор — сервер SCADA-мониторинга промышленного оборудования. Разворачивается на площадке заказчика, поставляется коробочной лицензией на один производственный участок. Поддерживает опрос контроллеров по OPC UA и Modbus, сбор метрик в реальном времени, алёртинг при выходе параметров за допуск.",
      "visibility": "ORGANIZATION"
    },
    {
      "key": "vektor-deploy",
      "title": "Вектор — руководство по развёртыванию",
      "description": "Требования к серверу и шаги развёртывания коробочной лицензии. Приложен файл с детальным руководством.",
      "content": "Подробное руководство по развёртыванию коробочной лицензии Вектор приведено во вложении. Требуется сервер с ОС Linux, 8 ГБ ОЗУ, доступ к контроллерам по сети.",
      "visibility": "DEPARTMENTS",
      "attachments": [
        "vektor-deploy-guide.md"
      ]
    },
    {
      "key": "reper-overview",
      "title": "Репер — обзор продукта",
      "description": "Краткое описание телематики транспорта для предпродажных консультаций.",
      "content": "Репер — облачная платформа телематики для транспорта и спецтехники. Сбор данных с бортовых контроллеров, контроль топлива, моточасов, геозон. Оплата по подписке за единицу техники.",
      "visibility": "ORGANIZATION"
    },
    {
      "key": "reper-telematics",
      "title": "Репер — спецификация телематики",
      "description": "Поддерживаемые протоколы и бортовые контроллеры. Приложен файл со спецификацией.",
      "content": "Поддерживаемые протоколы обмена с бортовыми контроллерами и список совместимого оборудования приведены во вложении.",
      "visibility": "DEPARTMENTS",
      "attachments": [
        "reper-telematics-spec.md"
      ]
